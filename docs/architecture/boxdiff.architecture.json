  "cards": [
    {
      "dot": "cyan",
      "title": "100% Browser-Only Multi-Modal Diff (v1)",
      "items": [
        "Text & Contract Redlines (.pdf, .docx, .txt, .md, .json) with Patience LCS + $/ % / Date / Legal Clause callouts.",
        "Visual Split Curtain Slider + Crimson Pixel-Delta Overlay across multi-page PDFs and PNG/JPEG/WebP images.",
        "Zero-CVE OpenXML .xlsx + RFC-4180 .csv Auditor catching altered =SUM() formulas and hardcoded overrides."
      ]
    },
    {
      "dot": "emerald",
      "title": "Version History + Sibling File Workflows",
      "items": [
        "Merges GET /files/:id/versions (v1..vN-1) with active file_version (vN) and auto-diffs v(N-1) -> vN on launch.",
        "Parent Folder Web Integration scope auto-discovers compatible sibling files when a file only has v1.",
        "Cross-format capable: redlines .docx drafts directly against signed .pdf files and .csv against .xlsx."
      ]
    },
    {
      "dot": "rose",
      "title": "Zero-PII Stateless Cloud Architecture",
      "items": [
        "Zero file bytes, diff hunks, filenames, emails, or Box OAuth tokens ever transit or persist on GCP.",
        "Domain-separated HMAC-SHA256(pepper, 'boxdiff:v1:box_user:' + id) isolates quotas in boxdiff_entitlements.",
        "Exports WinAnsi-safe Redline_Report.pdf straight from browser RAM back into the user's Box folder."
      ]
    }
  ]
