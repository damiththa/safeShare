# SafeShare for Box — Cloud Run Environment & Secret Manager Template
# Zero secrets are ever stored in Git or on local machines.
# Secret values are injected directly into GCP Cloud Run from Secret Manager (`--set-secrets`).

APP_PUBLIC_NAME="SafeShare for Box"
SUPPORT_EMAIL=""
GCP_PROJECT_ID="safeshare-box"
USE_FIRESTORE="true"
FIRESTORE_COLLECTION="safeshare_entitlements"
FREE_SCRUB_LIMIT="3"
FREE_RADAR_FIX_LIMIT="5"

# Mounted via GCP Secret Manager (--set-secrets):
# BOX_CLIENT_ID=BOX_CLIENT_ID:latest
# BOX_CLIENT_SECRET=BOX_CLIENT_SECRET:latest
# HMAC_PEPPER=HMAC_PEPPER:latest
