# BoxDiff for Box — Cloud Run Environment & Secret Manager Template
# Zero secrets are ever stored in Git or on local machines.
# Secret values are injected directly into GCP Cloud Run from Secret Manager (`--set-secrets`).

APP_PUBLIC_NAME="BoxDiff for Box"
SUPPORT_EMAIL=""
GCP_PROJECT_ID="safeshare-box"
USE_FIRESTORE="true"
FIRESTORE_COLLECTION="boxdiff_entitlements"
FREE_DIFF_LIMIT="5"

# Mounted via GCP Secret Manager (--set-secrets):
# BOXDIFF_CLIENT_ID=BOXDIFF_CLIENT_ID:latest
# BOXDIFF_CLIENT_SECRET=BOXDIFF_CLIENT_SECRET:latest
# HMAC_PEPPER=HMAC_PEPPER:latest
